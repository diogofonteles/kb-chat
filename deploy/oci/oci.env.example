# Inputs of deploy/oci/provision.sh. Copy to deploy/oci/oci.env (git-ignored) or, better,
# outside the repository (~/.config/kb-chat/oci.env) and pass it with --env.
# Nothing here is a secret: the OCI CLI reads its own credentials from ~/.oci/config.

# Tenancy and compartment (Console -> Identity -> Compartments). A dedicated compartment
# "kb-chat" keeps the resources and the cost report separate.
TENANCY_OCID=ocid1.tenancy.oc1..replace-me
COMPARTMENT_OCID=ocid1.compartment.oc1..replace-me
# Home region (Always Free compute exists only there), e.g. sa-saopaulo-1, sa-vinhedo-1.
REGION=sa-saopaulo-1
# Leave empty to use the first availability domain; set another one on "Out of host capacity".
AVAILABILITY_DOMAIN=

NAME_PREFIX=kb-chat
# Always Free A1 allowance (2026-06): 2 OCPUs and 12 GB in total for the tenancy.
OCPUS=2
MEMORY_GB=12
# Block storage: 200 GB in total (boot + block volumes). Boot minimum is 47 GB; block volume
# minimum is 50 GB.
BOOT_VOLUME_GB=50
DATA_VOLUME_GB=50

# Public keys (the private halves stay with the owner and in the GitHub environment).
OWNER_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
CI_SSH_PUBLIC_KEY_FILE=~/.ssh/kb-chat-ci.pub
# Who may reach port 22. 0.0.0.0/0 lets GitHub-hosted runners deploy (keys only, fail2ban);
# narrow it if deploys move to a fixed address.
SSH_SOURCE_CIDR=0.0.0.0/0

# Object Storage bucket for the encrypted state backups (20 GB Always Free).
BACKUP_BUCKET=kb-chat-backups
# Monthly budget alert (US$) sent to this e-mail: any spend means something left Always Free.
BUDGET_USD=1
BUDGET_ALERT_EMAIL=owner@example.com
