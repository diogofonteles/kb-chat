# kb-chat on the VM (ADR 0010). Copy to /srv/kb-chat/deploy/.env, owned by root, mode 0600:
#   sudo install -m 0600 -o root -g root /dev/null /srv/kb-chat/deploy/.env && sudo nano /srv/kb-chat/deploy/.env
# Never commit the real file (.env is in .gitignore). Values marked SECRET stay only there.

# Public host name (DNS A record -> the VM's reserved public IP). Caddy gets its certificate.
# Free option: a DuckDNS subdomain (runbook, step 4), e.g. nova-alexandria.duckdns.org.
KB_CHAT_DOMAIN=kb.example.com
# Only when the SPA is served from another origin than https://$KB_CHAT_DOMAIN.
# WEB_ORIGIN=https://kb.example.com

# Collection opened by default (otherwise the largest one).
# KB_TOPIC=hermetismo
LOG_LEVEL=info
SEARCH_RATE_LIMIT=120

# Sign-in (KBC-010, ADR 0008). The client id is public (served to the browser at run time);
# its "Authorized JavaScript origins" must list https://$KB_CHAT_DOMAIN.
GOOGLE_CLIENT_ID=
KB_CHAT_OWNER_EMAIL=

# One-time codes and access request notices by email (KBC-014, ADR 0011/0012). The API refuses
# to start in production without ONE complete provider (docs/deploy/runbook.md, step 4b).
# Option A, free, to anyone (~500 recipients/day): Gmail SMTP with an app password of a
# dedicated Gmail account (2-step verification on). Type the password on the VM with
# `read -s`, never in a chat or a command argument. SECRET:
# e.g. nova.alexandria.avisos@gmail.com
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Sender shown to people; default "Nova Alexandria <SMTP_USER>" (Gmail sends only as the account).
# KB_CHAT_EMAIL_FROM=Nova Alexandria <nova.alexandria.avisos@gmail.com>
# Option B, when a domain of yours is verified in Resend (leave the SMTP pair empty). SECRET:
# RESEND_API_KEY=
# KB_CHAT_EMAIL_FROM=Nova Alexandria <nao-responda@example.com>
# SMS codes: off until the owner picks a paid provider (no free one for Brazil, ADR 0011).
# KB_CHAT_SMS=off

# AI (ADR 0007). The owner's Claude subscription needs no key: `claude /login` once over SSH
# (docs/deploy/runbook.md). Per-token keys are optional. SECRET:
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
KB_CHAT_DAILY_CAP_USD=1

# Memory cap of the API container (the VM has 12 GB on the Always Free A1 allowance).
API_MEM_LIMIT=8g
# Image registry (owner/namespace on GHCR).
# KB_CHAT_REGISTRY=ghcr.io/diogofonteles
