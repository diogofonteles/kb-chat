# API (apps/api) — every variable is optional; defaults in apps/api/src/config.ts.
PORT=3000
WEB_ORIGIN=http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1
# kb vault root (the folder with kb.toml)
KB_VAULT=~/dev/personal/hermetismo
KB_BIN=kb
# QMD needs Node 24 on this machine: ~/.local/bin/qmd is a wrapper that provides it
QMD_BIN=qmd
# qmd (real index) | fixture (in-process index over the files; tests and E2E)
KB_CHAT_SEARCH=qmd
# Topic opened by default (otherwise the largest one)
# KB_TOPIC=hermetismo
# Searches per minute per client
SEARCH_RATE_LIMIT=120
LOG_LEVEL=info
# Local state: spend ledger, usage log and settings/<principal>.json (preferences, AI provider, keys; 0600)
# KB_CHAT_STATE_DIR=~/.kb-chat
# AI provider defaults while Settings choose none (KBC-007 BR-4); Settings win when set.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# KB_CHAT_MODEL=deepseek/deepseek-v4-flash
# KB_CHAT_DAILY_CAP_USD=1
# Official CLIs for the Claude and ChatGPT subscriptions (looked up on PATH)
# CLAUDE_BIN=claude
# CODEX_BIN=codex
