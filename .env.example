# API (apps/api) — defaults in apps/api/src/config.ts. `pnpm dev:api` reads this file from the
# repository root (.env, gitignored). Sign-in is required (KBC-010, ADR 0008):
# Google OAuth client id (public) of the "Entrar com Google" button; its authorized JavaScript
# origins must include the web origin (e.g. http://localhost:4200)
GOOGLE_CLIENT_ID=
# The owner's Google account: the first master, and the only one using the subscriptions
KB_CHAT_OWNER_EMAIL=
# Sign-in attempts per minute per client
# AUTH_RATE_LIMIT=10
# One-time codes and access request notices by email (KBC-014, ADR 0011/0012). Without a
# provider the messages (codes included) go to the API log: development only. With
# NODE_ENV=production the API refuses to start without one complete provider:
# Gmail SMTP (free, any recipient): SMTP_USER + SMTP_PASSWORD (an app password); setting only
# one of the two stops the API in any environment.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# Resend (needs a verified domain): RESEND_API_KEY + KB_CHAT_EMAIL_FROM.
# RESEND_API_KEY=
# Sender; with SMTP the default is "Nova Alexandria <SMTP_USER>".
# KB_CHAT_EMAIL_FROM=Nova Alexandria <nao-responda@example.com>
# SMS codes: off (default; no free provider for Brazil) | log (development: the code goes to the API log)
# KB_CHAT_SMS=off
# NODE_ENV=development
# Everything below is optional.
PORT=3000
# Interface to listen on (the container sets 0.0.0.0 behind Caddy; ADR 0010)
# HOST=127.0.0.1
WEB_ORIGIN=http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1
# Proxies trusted for X-Forwarded-For (Fastify trustProxy syntax, e.g. uniquelocal); unset locally
# TRUST_PROXY=
# kb vault root (the folder with kb.toml)
KB_VAULT=~/dev/personal/hermetismo
KB_BIN=kb
# QMD needs Node 24 on this machine: ~/.local/bin/qmd is a wrapper that provides it
QMD_BIN=qmd
# qmd (real index) | fixture (in-process index over the files; tests and E2E)
KB_CHAT_SEARCH=qmd
# Topic opened by default (otherwise the largest one)
# KB_TOPIC=hermetismo
# Searches per minute per client
SEARCH_RATE_LIMIT=120
LOG_LEVEL=info
# Local state: spend ledger, usage log, conversations, settings/<principal>.json (preferences, AI provider, keys),
# people.json and sessions/ (0600)
# KB_CHAT_STATE_DIR=~/.kb-chat
# Master key of the AI keys on disk (AES-256-GCM, ADR 0016). Optional locally: without it the API
# creates <KB_CHAT_STATE_DIR>/secrets.key (0600) once. Required in production.
# KB_CHAT_SECRETS_KEY=
# AI research agent (ADR 0006, 0016). Each person chooses in Settings; a master lends the app's AI
# ("IA da aplicação"). `local` restores ADR 0007's defaults for the owner with nothing chosen: the
# Claude subscription when `claude` is on PATH, then the keys below. Refused in production.
# KB_CHAT_AI_DEFAULTS=local
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenRouter model with tool calling, for both research profiles (default: fast
# deepseek/deepseek-v4-flash, deep deepseek/deepseek-v4-pro; ADR 0009). Settings may set each one.
# KB_CHAT_MODEL=deepseek/deepseek-v4-pro
# OpenRouter model reasoning on each agent call: off | on (default off)
# KB_CHAT_REASONING=off
# openrouter | stub (scripted research turn for tests and E2E, when nothing else serves; refused in production)
# KB_CHAT_LLM=openrouter
# Daily AI spend cap in US$ for per-token providers, checked before every model call
# KB_CHAT_DAILY_CAP_USD=1
# Exhaustive research profile (KBC-017, ADR 0013): tool steps (10-300) and output tokens per call (2000-64000)
# KB_CHAT_EXHAUSTIVE_STEPS=80
# KB_CHAT_EXHAUSTIVE_OUTPUT_TOKENS=16000
# Official CLIs for the Claude and ChatGPT subscriptions (looked up on PATH)
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# The ChatGPT subscription (Codex CLI) cannot be limited to the kb tools: off unless enabled (ADR 0007)
# KB_CHAT_CODEX=off
