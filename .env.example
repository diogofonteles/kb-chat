# API (apps/api) — every variable is optional; defaults in apps/api/src/config.ts.
PORT=3000
WEB_ORIGIN=http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1
# kb vault root (the folder with kb.toml)
KB_VAULT=~/dev/personal/hermetismo
KB_BIN=kb
# QMD needs Node 24 on this machine: ~/.local/bin/qmd is a wrapper that provides it
QMD_BIN=qmd
# qmd (real index) | fixture (in-process index over the files; tests and E2E)
KB_CHAT_SEARCH=qmd
# Topic opened by default (otherwise the largest one)
# KB_TOPIC=hermetismo
# Searches per minute per client
SEARCH_RATE_LIMIT=120
LOG_LEVEL=info
# Local state: spend ledger, usage log, conversations and settings/<principal>.json (preferences, AI provider, keys; 0600)
# KB_CHAT_STATE_DIR=~/.kb-chat
# AI research agent (ADR 0006). The provider comes from Settings; while Settings choose none
# (KBC-007 BR-4): the Claude subscription when `claude` is on PATH, then these keys, else search only.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenRouter model with tool calling (default deepseek/deepseek-v4-pro)
# KB_CHAT_MODEL=deepseek/deepseek-v4-pro
# OpenRouter model reasoning on each agent call: off | on (default off)
# KB_CHAT_REASONING=off
# openrouter | stub (scripted research turn for tests and E2E; wins over everything)
# KB_CHAT_LLM=openrouter
# Daily AI spend cap in US$ for per-token providers, checked before every model call
# KB_CHAT_DAILY_CAP_USD=1
# Official CLIs for the Claude and ChatGPT subscriptions (looked up on PATH)
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# The ChatGPT subscription (Codex CLI) cannot be limited to the kb tools: off unless enabled (ADR 0007)
# KB_CHAT_CODEX=off
