{
  "name": "kb-chat",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kb-chat/api dev",
    "dev:web": "pnpm --filter @kb-chat/web start",
    "typecheck": "tools/heavy.sh nx run-many -t typecheck --output-style=stream",
    "test": "tools/heavy.sh nx run-many -t test --output-style=stream",
    "build": "tools/heavy.sh nx run-many -t build --output-style=stream",
    "lint": "tools/heavy.sh nx run-many -t lint --output-style=stream",
    "gates": "node --no-warnings tools/check-node.mjs && tools/heavy.sh sh -c 'pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check'",
    "e2e": "pnpm --filter @kb-chat/e2e e2e",
    "tutorial:screenshots": "pnpm --filter @kb-chat/e2e exec playwright test -c tutorial.config.ts && prettier --write apps/web/src/app/features/tutorial/tutorial-images.generated.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.0.1",
    "nx": "21.0.3",
    "prettier": "3.9.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.63.0"
  }
}
