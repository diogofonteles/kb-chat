{
  "name": "@kb-chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "e2e:server": "tsx src/e2e/server.ts",
    "latency": "tsx src/scripts/latency.ts",
    "usage-report": "tsx src/scripts/usage-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.1.0",
    "@kb-chat/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "5.2.0",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "6.0.0",
    "pino": "9.14.0",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "tsx": "4.19.2",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
